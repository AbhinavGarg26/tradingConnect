[Unit]
Description=Backfill missing 10-session paper strategy trades
After=network-online.target strategy-status-observer.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/tradingConnect
EnvironmentFile=/home/ubuntu/tradingConnect/deploy/ema-strategies.env
ExecStart=/home/ubuntu/tradingConnect/.venv/bin/python /home/ubuntu/tradingConnect/strategy_day_end.py --user-id ${EMA_USER_ID}

