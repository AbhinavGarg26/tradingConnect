[Unit]
Description=Frozen directional Groww ORB intraday option runner (mode set by Strategy Controls)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/tradingConnect
EnvironmentFile=/home/ubuntu/tradingConnect/deploy/ema-strategies.env
ExecStart=/home/ubuntu/tradingConnect/.venv/bin/python /home/ubuntu/tradingConnect/groww_orb_live.py --user-id ${EMA_USER_ID}
