[Unit]
Description=Process authenticated dashboard strategy control requests
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=deployer
Group=deployer
WorkingDirectory=/home/deployer/apps/tradingConnect
EnvironmentFile=/home/deployer/apps/tradingConnect/deploy/ema-strategies.env
ExecStart=/home/deployer/apps/tradingConnect/.venv/bin/python /home/deployer/apps/tradingConnect/strategy_control_worker.py --user-id ${EMA_USER_ID}
Restart=on-failure
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
