[Unit]
Description=NIFTY 15-minute breakout v3 live option runner
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=deployer
Group=deployer
WorkingDirectory=/home/deployer/apps/tradingConnect
EnvironmentFile=/home/deployer/apps/tradingConnect/deploy/ema-strategies.env
ExecStart=/home/deployer/apps/tradingConnect/.venv/bin/python /home/deployer/apps/tradingConnect/nifty_15m_live.py --user-id ${EMA_USER_ID} --live --token-attempts 0 --token-retry-seconds 300
Restart=no
RuntimeMaxSec=7h
TimeoutStopSec=30
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal

