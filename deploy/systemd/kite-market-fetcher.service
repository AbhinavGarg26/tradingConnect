[Unit]
Description=TradingConnect Kite market data fetcher
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=deployer
Group=deployer
WorkingDirectory=/home/deployer/apps/tradingConnect
ExecStart=/home/deployer/apps/tradingConnect/.venv/bin/python /home/deployer/apps/tradingConnect/kite_market_fetcher.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
