[Unit]
Description=One Direction Profit Lock V2.1 (durable PAPER evidence collector)
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/tradingConnect
EnvironmentFile=/home/ubuntu/tradingConnect/deploy/ema-strategies.env
ExecStart=/home/ubuntu/tradingConnect/.venv/bin/python /home/ubuntu/tradingConnect/one_direction_profit_lock_service.py --user-id ${EMA_USER_ID}
Restart=no
RuntimeMaxSec=7h
TimeoutStopSec=30
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal

